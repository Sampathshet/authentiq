AUTHENTIQ_APP_NAME=AUTHENTIQ
AUTHENTIQ_ENVIRONMENT=development
AUTHENTIQ_DEBUG=true
AUTHENTIQ_SECRET_KEY=replace-with-a-long-random-secret-at-least-48-characters
AUTHENTIQ_ACCESS_TOKEN_MINUTES=45
AUTHENTIQ_REFRESH_TOKEN_DAYS=14
AUTHENTIQ_RESET_TOKEN_MINUTES=30
AUTHENTIQ_PASSWORD_MIN_LENGTH=10

AUTHENTIQ_DATABASE_URL=postgresql://user:password@host/database?sslmode=require
AUTHENTIQ_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://localhost:8080
AUTHENTIQ_PUBLIC_APP_URL=http://localhost:5173
AUTHENTIQ_API_PUBLIC_URL=http://localhost:8000

AUTHENTIQ_STORAGE_DIR=storage
AUTHENTIQ_UPLOAD_DIR=storage/uploads
AUTHENTIQ_EVIDENCE_DIR=storage/evidence
AUTHENTIQ_LEDGER_FILE=storage/ledger.jsonl
AUTHENTIQ_MAX_FILE_SIZE_MB=200
AUTHENTIQ_MAX_CHUNK_SIZE_MB=8

AUTHENTIQ_LEDGER_MODE=simulation
AUTHENTIQ_LEDGER_NETWORK=AUTHENTIQ Local Ledger
AUTHENTIQ_CHAIN_RPC_URL=
AUTHENTIQ_CHAIN_PRIVATE_KEY=
AUTHENTIQ_CHAIN_CONTRACT_ADDRESS=
AUTHENTIQ_CHAIN_ID=80002
AUTHENTIQ_CHAIN_EXPLORER_URL=https://amoy.polygonscan.com

AUTHENTIQ_ZKP_MODE=sigma
AUTHENTIQ_ZKP_CHALLENGE_MINUTES=10
AUTHENTIQ_ZKP_VERIFICATION_HOURS=72
AUTHENTIQ_GROTH16_WASM=
AUTHENTIQ_GROTH16_ZKEY=
AUTHENTIQ_GROTH16_VKEY=

AUTHENTIQ_LOGIN_RATE_LIMIT=8
AUTHENTIQ_LOGIN_RATE_WINDOW_SECONDS=300
AUTHENTIQ_REGISTRATION_RATE_LIMIT=30
AUTHENTIQ_REGISTRATION_RATE_WINDOW_SECONDS=3600

AUTHENTIQ_DEMO_MODE=true
AUTHENTIQ_SEED_DEMO=false
AUTHENTIQ_ACCESS_LOG=true

VITE_API_URL=/api
